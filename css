/* ============ БАЗА ============ */
* { box-sizing: border-box; margin: 0; padding: 0; }

:root {
    --green-dark: #14301f;
    --green: #2e7d32;
    --green-light: #a5d6a7;
    --sand: #f5f2ec;
    --text: #1a1a1a;
    --white: #ffffff;
    --radius: 16px;
    --shadow: 0 10px 30px rgba(0,0,0,0.08);
    --transition: 0.3s ease;
}

html { scroll-behavior: smooth; }

body {
    font-family: 'Manrope', system-ui, sans-serif;
    color: var(--text);
    background: var(--sand);
    line-height: 1.6;
}

h1, h2, h3, .logo, .footer-logo {
    font-family: 'Unbounded', 'Manrope', sans-serif;
    letter-spacing: -0.02em;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

img { max-width: 100%; display: block; }

/* ============ КНОПКИ ============ */
.btn {
    display: inline-block;
    padding: 14px 30px;
    background: var(--green);
    color: var(--white);
    text-decoration: none;
    border: 2px solid var(--green);
    border-radius: 50px;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition);
    font-size: 0.95rem;
    font-family: 'Manrope', sans-serif;
}

.btn:hover {
    background: var(--green-dark);
    border-color: var(--green-dark);
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(46,125,50,0.3);
}

.btn-outline {
    background: transparent;
    color: var(--green);
}

.btn-outline:hover {
    background: var(--green);
    color: var(--white);
}

/* ============ HEADER ============ */
.header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255,255,255,0.9);
    backdrop-filter: blur(12px);
    box-shadow: 0 2px 12px rgba(0,0,0,0.05);
}

.nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 20px;
}

.logo {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--green-dark);
    text-decoration: none;
    transition: var(--transition);
}

.logo span { color: var(--green); }

.nav-list {
    display: flex;
    list-style: none;
    gap: 32px;
}

.nav-list a {
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
    position: relative;
    transition: var(--transition);
    font-size: 0.95rem;
}

.nav-list a::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--green);
    transition: width var(--transition);
}

.nav-list a:hover { color: var(--green); }
.nav-list a:hover::after { width: 100%; }

/* ============ HERO ============ */
.hero {
    min-height: 92vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background:
        linear-gradient(135deg, rgba(20,48,31,0.85), rgba(46,125,50,0.75)),
        url('https://images.unsplash.com/photo-1502005229762-cf1b2da7c5d6?w=1600&q=80') center/cover no-repeat;
    position: relative;
    overflow: hidden;
}

.hero-content {
    position: relative;
    z-index: 2;
    color: var(--white);
    animation: fadeUp 1s ease both;
    max-width: 800px;
}

.hero-tag {
    display: inline-block;
    padding: 6px 18px;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 50px;
    font-size: 0.85rem;
    margin-bottom: 24px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
}

.hero h1 {
    font-size: clamp(2rem, 5.5vw, 3.8rem);
    margin-bottom: 24px;
    line-height: 1.1;
}

.hero-text {
    font-size: clamp(1rem, 2vw, 1.2rem);
    max-width: 600px;
    margin: 0 auto 40px;
    opacity: 0.95;
    font-weight: 300;
}

.hero .btn {
    background: var(--white);
    color: var(--green-dark);
    border-color: var(--white);
    font-size: 1rem;
    padding: 18px 42px;
}

.hero .btn:hover {
    background: transparent;
    color: var(--white);
    transform: translateY(-4px) scale(1.03);
}

@keyframes fadeUp {
    from { opacity: 0; transform: translateY(40px); }
    to   { opacity: 1; transform: translateY(0); }
}

/* ============ CATALOG ============ */
.catalog {
    padding: 110px 20px;
}

.section-title {
    text-align: center;
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    margin-bottom: 60px;
    color: var(--green-dark);
    position: relative;
}

.section-title::after {
    content: '';
    display: block;
    width: 60px;
    height: 4px;
    background: var(--green);
    margin: 18px auto 0;
    border-radius: 2px;
}

.section-title--left { text-align: left; }
.section-title--left::after { margin: 18px 0 0; }

.cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 32px;
}

.card {
    background: var(--white);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    transition: transform var(--transition), box-shadow var(--transition);
}

.card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.15);
}

.card-img {
    height: 220px;
    overflow: hidden;
}

.card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
}

.card:hover .card-img img {
    transform: scale(1.08);
}

.card-body {
    padding: 26px 24px 28px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.card h3 {
    margin-bottom: 10px;
    color: var(--green-dark);
    font-size: 1.2rem;
}

.card p {
    color: #555;
    font-size: 0.95rem;
    flex-grow: 1;
    margin-bottom: 18px;
}

.card .price {
    font-weight: 700;
    color: var(--green);
    font-size: 1.1rem;
    margin-bottom: 18px;
    font-family: 'Unbounded', sans-serif;
}

.card .btn-outline {
    padding: 11px 24px;
    align-self: flex-start;
}

/* ============ INFO ============ */
.info {
    background: var(--white);
    padding: 110px 20px;
}

.info-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 70px;
    align-items: center;
}

.info-text p {
    color: #555;
    margin-bottom: 24px;
}

.info-list {
    list-style: none;
    margin: 0 0 32px;
}

.info-list li {
    padding: 10px 0 10px 32px;
    position: relative;
    font-size: 1.02rem;
}

.info-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    background: var(--green-light);
    border-radius: 50%;
}

.info-visual {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    aspect-ratio: 4 / 5;
    animation: float 6s ease-in-out infinite;
}

.info-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

@keyframes float {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-14px); }
}

/* ============ FOOTER ============ */
.footer {
    background: var(--green-dark);
    color: var(--white);
    padding: 70px 20px 24px;
}

.footer-inner {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 40px;
    padding-bottom: 44px;
    border-bottom: 1px solid rgba(255,255,255,0.15);
}

.footer-logo {
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 10px;
}

.footer-logo span { color: var(--green-light); }

.footer-note {
    opacity: 0.7;
    font-size: 0.95rem;
    max-width: 320px;
}

.footer-contacts p {
    padding: 5px 0;
    opacity: 0.9;
}

.copyright {
    text-align: center;
    padding-top: 24px;
    opacity: 0.55;
    font-size: 0.88rem;
}

/* ============ АДАПТИВ ============ */
@media (max-width: 768px) {
    .nav {
        flex-direction: column;
        gap: 14px;
        padding: 14px 20px;
    }

    .nav-list { gap: 22px; }

    .hero { min-height: 85vh; }

    .info-grid {
        grid-template-columns: 1fr;
        gap: 40px;
    }

    .info-visual {
        max-width: 380px;
        margin: 0 auto;
        aspect-ratio: 1 / 1;
    }

    .footer-inner {
        flex-direction: column;
        text-align: center;
        gap: 28px;
    }

    .footer-note { margin: 0 auto; }

    .card .btn-outline { align-self: center; }
    .card-body { text-align: center; }
    .section-title--left { text-align: center; }
    .section-title--left::after { margin: 18px auto 0; }
    .info-list li { text-align: left; }
}

@media (max-width: 480px) {
    .catalog, .info { padding: 70px 16px; }
    .nav-list { font-size: 0.9rem; gap: 16px; }
    .hero .btn { padding: 14px 32px; }
}
